{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uuzzrm/kona/blob/main/schemas/contract.schema.json",
  "title": "Kona Evidence Contract",
  "description": "A local, declarative acceptance contract for one authorized command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cwd": {"$ref": "#/$defs/relativePath"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "timeout": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relativePath"},
      "uniqueItems": true
    },
    "workspace_policy": {"$ref": "#/$defs/workspacePolicy"},
    "assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "workspaceGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "workspacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow", "deny", "max_changed_paths"],
      "properties": {
        "mode": {"const": "filesystem"},
        "allow": {"type": "array", "items": {"$ref": "#/$defs/workspaceGlob"}, "uniqueItems": true},
        "deny": {"type": "array", "items": {"$ref": "#/$defs/workspaceGlob"}, "uniqueItems": true},
        "max_changed_paths": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "exit_code",
            "status",
            "stdout_contains",
            "stdout_not_contains",
            "stderr_contains",
            "stderr_not_contains",
            "file_exists",
            "file_content_contains",
            "file_content_not_contains",
            "file_sha256",
            "file_changed",
            "file_unchanged",
            "file_created",
            "file_deleted"
          ]
        },
        "equals": {},
        "path": {"$ref": "#/$defs/relativePath"},
        "value": {"type": "string"}
      },
      "oneOf": [
        {"properties": {"type": {"const": "exit_code"}, "equals": {"type": "integer"}}, "required": ["equals"]},
        {"properties": {"type": {"const": "status"}, "equals": {"enum": ["success", "failed", "timed_out"]}}, "required": ["equals"]},
        {"properties": {"type": {"enum": ["stdout_contains", "stdout_not_contains", "stderr_contains", "stderr_not_contains"]}, "value": {"type": "string", "minLength": 1}}, "required": ["value"]},
        {"properties": {"type": {"const": "file_exists"}, "path": {"$ref": "#/$defs/relativePath"}, "equals": {"type": "boolean"}}, "required": ["path"]},
        {"properties": {"type": {"enum": ["file_content_contains", "file_content_not_contains"]}, "path": {"$ref": "#/$defs/relativePath"}, "value": {"type": "string", "minLength": 1}}, "required": ["path", "value"]},
        {"properties": {"type": {"const": "file_sha256"}, "path": {"$ref": "#/$defs/relativePath"}, "equals": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}, "required": ["path", "equals"]},
        {"properties": {"type": {"enum": ["file_changed", "file_unchanged", "file_created", "file_deleted"]}, "path": {"$ref": "#/$defs/relativePath"}, "equals": {"type": "boolean"}}, "required": ["path"]}
      ]
    }
  }
}
